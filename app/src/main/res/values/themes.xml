<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ApiMovil" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/marca</item>
        <item name="colorPrimaryVariant">@color/marca_oscuro</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/marca_claro</item>
        <item name="colorOnSecondary">@color/texto_principal</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/marca_oscuro</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/marca</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/marca</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/marca_claro</item>
    </style>

    <style name="Widget.App.Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/marca_claro</item>
        <item name="android:textColor">@color/marca_oscuro</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconTint">@color/marca</item>
        <item name="rippleColor">@color/marca</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
