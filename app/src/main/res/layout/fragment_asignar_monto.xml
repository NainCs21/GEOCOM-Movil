<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/blanco"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/volver" />

        <TextView
            android:text="@string/asignar_monto_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Resumen de la solicitud -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta"
                android:padding="18dp">

                <TextView
                    android:id="@+id/textResumenConductor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/texto_principal" />

                <TextView
                    android:id="@+id/textResumenDestino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/marca"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/textResumenActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/gasolinera">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerGasolinera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/horas_de_vigencia_1_a_3">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputHorasVigencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Monto vehiculo -->
            <LinearLayout
                android:id="@+id/tarjetaMontoVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta"
                android:padding="17dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:text="@string/linea_01_vehiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/texto_principal" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/monto_vehiculo_lempiras">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputMontoVehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonto500Vehiculo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:textSize="11sp"
                        android:text="500"
                        app:cornerRadius="18dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonto1000Vehiculo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:textSize="11sp"
                        android:text="1000"
                        app:cornerRadius="18dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:layout_marginHorizontal="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonto1500Vehiculo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:textSize="11sp"
                        android:text="1500"
                        app:cornerRadius="18dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Monto MGP -->
            <LinearLayout
                android:id="@+id/tarjetaMontoMgp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta"
                android:padding="17dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:text="@string/linea_02_mgp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/texto_principal" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/monto_mgp_lempiras">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputMontoMgp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonto500Mgp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:textSize="11sp"
                        android:text="500"
                        app:cornerRadius="18dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonto1000Mgp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:textSize="11sp"
                        android:text="1000"
                        app:cornerRadius="18dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:layout_marginHorizontal="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonto1500Mgp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:textSize="11sp"
                        android:text="1500"
                        app:cornerRadius="18dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta_info"
                android:padding="18dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/textTotalAsignado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/marca_oscuro" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAsignar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/asignar_y_generar_orden"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/marca" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/estado_vencida"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
