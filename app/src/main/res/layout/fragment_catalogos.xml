<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageButton
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/volver"
                    android:src="@drawable/ic_back"
                    app:tint="@color/blanco" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/catalogos"
                    android:textColor="@color/blanco"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNuevo"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/nuevo"
                    android:textColor="@color/marca_oscuro"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/marca_claro"
                    app:cornerRadius="18dp" />
            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleCatalogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:padding="12dp"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConductores"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/conductores"
            android:textColor="@color/selector_toggle_button_text"
            android:textSize="13sp"
            app:backgroundTint="@color/selector_toggle_button_bg"
            app:cornerRadius="12dp"
            app:strokeColor="@color/borde" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVehiculos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/vehiculos"
            android:textColor="@color/selector_toggle_button_text"
            android:textSize="13sp"
            app:backgroundTint="@color/selector_toggle_button_bg"
            app:cornerRadius="12dp"
            app:strokeColor="@color/borde" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGasolineras"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/gasolineras"
            android:textColor="@color/selector_toggle_button_text"
            android:textSize="13sp"
            app:backgroundTint="@color/selector_toggle_button_bg"
            app:cornerRadius="12dp"
            app:strokeColor="@color/borde" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Filtros para Vehículos -->
    <LinearLayout
        android:id="@+id/layoutFiltrosVehiculos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar por placa, marca, modelo..."
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputBuscarVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleFiltroCombustible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:checkedButton="@id/btnFiltroTodos"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroTodos"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Todos"
                android:textColor="@color/selector_toggle_button_text"
                android:textSize="12sp"
                app:backgroundTint="@color/selector_toggle_button_bg"
                app:strokeColor="@color/borde" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroGasolina"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Gasolina"
                android:textColor="@color/selector_toggle_button_text"
                android:textSize="12sp"
                app:backgroundTint="@color/selector_toggle_button_bg"
                app:strokeColor="@color/borde" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroDiesel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Diesel"
                android:textColor="@color/selector_toggle_button_text"
                android:textSize="12sp"
                app:backgroundTint="@color/selector_toggle_button_bg"
                app:strokeColor="@color/borde" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="88dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/estado_vencida"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/incluirNavInferior"
        layout="@layout/widget_bottom_nav_admin" />

</LinearLayout>
